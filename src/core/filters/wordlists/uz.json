{
  "lang": "uz",
  "allow": [
    "latin", "latina", "moda", "model", "modern", "taqin", "taqinchilik", "qirq", "yorq",
    "shukr", "shukrona", "shukron", "subhanalloh", "alhamdulillah",
    "sikka", "sikly", "sifat", "sikloped", "siklopedik",
    "tuman", "tumanlik", "tumanchilik", "tumanaga",
    "ichki", "ichkim", "ichkar", "ichkilik",
    "tana", "tanador", "tanaazo", "tanaga",
    "boq", "boqmoq", "boqimaja", "boqish", "boqADI",
    "eshak", "eshaklar", "it", "itlar", "mol", "mollar",
    "bosh", "mashaq", "mashq", "musht",
    "tut", "tutash", "tutib", "ushla", "ushlab", "ushlash",
    "yalmi", "yalmir", "yolgiz", "yolgizlon"
  ],
  "stems": [
    { "p": "xoroy[a-z]{0,4}|qoroy[a-z]{0,4}", "label": "xo'roy", "severity": 2, "mode": "core" },
    { "p": "(?:x|q)[o']?rop[a-z]{0,4}", "label": "xo'rop", "severity": 2, "mode": "core" },
    { "p": "(?:q|k)[oa]?n[hx][uy][iyae][a-z]{0,3}", "label": "qonxuy", "severity": 3, "mode": "core" },
    { "p": "qon(?:t|d)[ayou][xykcg][iyaeu][a-z]{0,4}", "label": "qontayir", "severity": 3, "mode": "core" },
    { "p": "(?:t|d)aqir[a-z]{0,4}", "label": "taqir", "severity": 1, "mode": "core" },
    { "p": "(?:mo|ma)[dt][ay][kc][a-z]{0,3}", "label": "mo'dak", "severity": 2, "mode": "core" },
    { "p": "has[h]?rag[a-z]{0,3}", "label": "hashrag", "severity": 2, "mode": "core" },
    { "p": "lanat[a-z]{0,4}", "label": "la'nat", "severity": 2, "mode": "core" },
    { "p": "(?:ja|zhy)?jop[a-z]{0,4}", "label": "jopa", "severity": 1, "mode": "core" },
    { "p": "(?:si|syy)[qk][ta][a-z]{0,3}", "label": "siqta", "severity": 2, "mode": "core" },
    { "p": "yiqit[a-z]{0,3}", "label": "yiqit", "severity": 1, "mode": "core" },

    { "p": "(?:sh|s|x|z)[uy]?[hxkcgq][uy]?r[a-z]{0,5}", "label": "suxur", "severity": 3, "mode": "core" },
    { "p": "(?:ma|mo)rd[iy][hxkcgq]?[uioa][rxn][a-z]{0,4}", "label": "mardixur", "severity": 3, "mode": "core" },
    { "p": "(?:a|o)l[ao']?p[ss]at[a-z]{0,4}", "label": "alo'psat", "severity": 3, "mode": "core" },
    { "p": "(?:u|o)(?:sh){1,3}[aoiue][a-z]{0,5}", "label": "ushshang", "severity": 2, "mode": "core" },
    { "p": "hur[uo](?:g|k|j)[a-z]{0,4}", "label": "hurug", "severity": 3, "mode": "core" },
    { "p": "yalm[iy]?z[a-z]{0,4}", "label": "yalmiz", "severity": 3, "mode": "core" },
    { "p": "ahm[oa]q[a-z]{0,4}", "label": "ahmoq", "severity": 1, "mode": "core" },
    { "p": "aqsh[iy]?q[a-z]{0,4}", "label": "aqshiq", "severity": 2, "mode": "core" },
    { "p": "(?:q|k)orab[oe]z[a-z]{0,4}", "label": "qoraboz", "severity": 2, "mode": "core" },
    { "p": "(?:si|sy)(?:k|q|h)(?:aman|asan|adi|ish|ib|ib|gan|moq|uvchi|ing)[a-z]{0,3}", "label": "sikish", "severity": 3, "mode": "core" },
    { "p": "bo['`\u2018]?x(?:im|ing|lari|siz)?[a-z]{0,3}", "label": "bo'x", "severity": 3, "mode": "core" },

    { "p": "\\bsolib\\s+(?:ket|bir\\s?ket|qet)\\b", "label": "so'lib ket", "severity": 3, "mode": "word" },
    { "p": "\\byiqib\\s?ket\\b", "label": "yiqib ket", "severity": 1, "mode": "word" },
    { "p": "\\b(?:seni|sening|u|uni)\\s+(?:on[aa]ng|onangni)\\b", "label": "seni onang", "severity": 3, "mode": "word" },
    { "p": "\\b(?:seni|sening)\\s+(?:tan[ai]ng|tanangni|ichki?ri?ng|ichqiring|(?:q|k)asalli?ng|pusti?ng|pustingni)\\b", "label": "seni tanang", "severity": 3, "mode": "word" },
    { "p": "\\b(?:seni|sening)\\s+(?:eshag[iy]ng|iting|mol[iy]ng|cho'chq[ao]ng)\\b", "label": "seni eshaging", "severity": 2, "mode": "word" },
    { "p": "\\b(?:yiq|chiq|ket|ur|solib yubor)\\s?(?:ib|a|in)?\\s?ket(?:ing|ingni)\\b", "label": "yiqib ket", "severity": 1, "mode": "word" },
    { "p": "\\bichk[iy]?ri?ng\\b", "label": "ichkiring", "severity": 3, "mode": "word" },
    { "p": "\\btanang\\b", "label": "tanang", "severity": 3, "mode": "word" },
    { "p": "\\bkalta\\s+(?:qo'y|qoy|kuydir|kuydur)\\b", "label": "kalta qo'y", "severity": 3, "mode": "word" },
    { "p": "\\b(?:allofsat|alopsoht|lo'psat|lopsoat)\\b", "label": "allofsat", "severity": 3, "mode": "word" },
    { "p": "\\b(?:yetimsiz|ota\\s?yoqsiz)\\b", "label": "yetimsiz", "severity": 2, "mode": "word" },
    { "p": "\\b(?:be'?pi|befa'li|be'razm)\\b", "label": "be'pi", "severity": 1, "mode": "word" }
  ]
}
